# Sepolia RPC endpoint (Infura / Alchemy free tier)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Deployer key — USE A THROWAWAY TESTNET KEY ONLY. Never a real/mainnet key.
DEPLOYER_PRIVATE_KEY=0xyour_testnet_private_key

# Etherscan (Sepolia) for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Governance signatories (2-of-3): ZQA, ECZ, HEA testnet addresses
GOV_OWNER_ZQA=0x0000000000000000000000000000000000000000
GOV_OWNER_ECZ=0x0000000000000000000000000000000000000000
GOV_OWNER_HEA=0x0000000000000000000000000000000000000000

REPORT_GAS=false
